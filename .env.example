# Example environment configuration for Helios
# Copy this to .env and fill in your values

# PostHog Analytics Configuration
POSTHOG_API_KEY=your_project_api_key_here
POSTHOG_HOST=https://us.i.posthog.com

# Web build PostHog (exposed to browser - safe to be public)
VITE_POSTHOG_API_KEY=your_project_api_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Development Mode (ONLY for local development)
# Set to true if you're behind a corporate proxy/firewall with HTTPS inspection
# This is automatically disabled in production builds
HELIOS_DEV_MODE=false

# SMTP Configuration (required for priority email verification and reminders)
# Example (Gmail app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Helios <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
