# Example environment configuration for Helios
# Copy this to .env and fill in your values

# PostHog Analytics Configuration
POSTHOG_API_KEY=your_project_api_key_here
POSTHOG_HOST=https://us.i.posthog.com

# Web build PostHog (exposed to browser - safe to be public)
VITE_POSTHOG_API_KEY=your_project_api_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Email API Configuration (for web browser users)
# For local development: points to Express server
# For production (Vercel): leave blank or set to /api/send-email
VITE_EMAIL_API_URL=http://localhost:3001/api/send-email
# Port for the local Express email server (default: 3001)
PORT=3001
# Allowed origin for CORS (your frontend URL, default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Development Mode (ONLY for local development)
# Set to true if you're behind a corporate proxy/firewall with HTTPS inspection
# This is automatically disabled in production builds
HELIOS_DEV_MODE=false

# SMTP Configuration (required for priority email verification and reminders)
# Example (Gmail app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Helios <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
